{% extends '_layouts/cp.twig' %}
{% import '_includes/forms.twig' as forms %}

{% set title = 'SEO Import' %}

{% set fullPageForm = true %}
{% set submitButtonLabel = 'Import' %}

{% set mainFormAttributes = {
    'enctype': 'multipart/form-data'
} %}

{% block content %}
    {{ actionInput('_craft-seo-import/import/import') }}

    {{ forms.fileField({
        label: 'Excel file',
        instructions: 'Select the Excel file with the SEO data to import.',
        id: 'file',
        name: 'file',
        required: true,
        errors: craft.app.session.getFlash('errors')['file'] ?? null
    }) }}

    {% if craft.app.isMultiSite() %}
        {% set sites = [] %}

        {% for site in craft.app.sites.getAllSites() %}
            {% set sites = sites|merge([{ label: site.name, value: site.id }]) %}
        {% endfor %}

        {{ forms.selectField({
            label: 'Site',
            instructions: 'Select the site where the SEO data will be imported.',
            id: 'siteId',
            name: 'siteId',
            options: sites,
            required: true,
            errors: craft.app.session.getFlash('errors')['site'] ?? null
        }) }}
    {% else %}
        {{ forms.hidden({
            id: 'siteId',
            name: 'siteId',
            value: craft.app.sites.primarySite.id,
        }) }}
    {% endif %}

    {{ forms.checkboxField({
        label: 'Overwrite meta title',
        id: 'overwrite-meta-title',
        name: 'overwriteMetaTitle',
    }) }}

    {{ forms.checkboxField({
        label: 'Overwrite meta description',
        id: 'overwrite-meta-description',
        name: 'overwriteMetaDescription',
    }) }}
{% endblock %}
